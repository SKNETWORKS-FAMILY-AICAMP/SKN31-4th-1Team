LLM_MODEL=gpt-5.4-mini
FALLBACK_LLM_MODEL=

NEO4J_URI=neo4j+s://<your_database_id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo4j_password>
NEO4J_DATABASE=neo4j

QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<your_qdrant_api_key>
OPENAI_API_KEY=<your_openai_api_key>

SUPABASE_URL=<your_supabase_url>
# [주의] 아래 키는 Supabase 대시보드 > Settings > API > JWT Secret 값을 넣어야 합니다.
# (service_role 또는 anon_key 가 아닙니다.) HS256 알고리즘 토큰 검증 시 사용됩니다.
SUPABASE_JWT_SECRET=<your_supabase_jwt_secret>
